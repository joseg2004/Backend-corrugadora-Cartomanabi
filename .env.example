# Database HANA - COPLAIM - EMVCLI - SGEP - DATOS
HANA_DB_COPLAIM=
HANA_DB_DATOS=
HANA_DB_EMVCLI=
HANA_DB_SGEP=

# Credenciales de HANA
HANA_HOST=
HANA_PORT=
HANA_USERNAME=
HANA_PASSWORD=
HANA_DATABASE=
HANA_DATABASE_AU=

# Credenciales de correos
OFFICE_HOST=
OFFICE_PORT=
OFFICE_USER=
OFFICE_PASS=

# Credenciales de sesión
SECRET_SESSION=

# Credenciales de ActiveDirectory
AD_URL=
AD_BASEDN=

# Config project
APP_PORT=
API_NODE_RED=

# Config token auth
SECRET_TOKEN=

# JWT Rotation Policy (seguridad)
JWT_SECRET_CREATED=2024-02-10
JWT_SECRET_ROTATION_DAYS=90

# Redis para Token Blacklist (opcional, usa memoria si no está configurado)
REDIS_URL=redis://localhost:6379

# Accept connections from the client
CLIENT_SERVER=

# Config of the cookies
COOKIE_HTTP=true
COOKIE_SECURE=true
COOKIE_MAXAGE=28800000
COOKIE_SAMESITE=strict

# Config docker
PORT_TCP=
SYNC_DOCS=
NETWORK=

# Email requisiciones
EMAIL_BODEGA=
NAME_BODEGA=

# Config mail jobs
API_JOBS=
EMAIL_GERENCIA=
EMAIL_CONTABILIDAD=
PASS_CONTABILIDAD=
EMAIL_IMPORTACIONES=
PASS_IMPORTACIONES=

# Config Service Layer SAP - HANA
SL_URL=
SL_USER=
SL_PASS=

# Clave para cifrado/descifrado de contraseña SAP (debe coincidir con VITE_SAP_ENCRYPTION_PUBLIC del frontend)
SAP_ENCRYPTION_KEY=
